# Frontend env vars. Copy to .env.local for local overrides.

# Production: point at your Railway backend (no trailing slash, no /api suffix)
# VITE_API_URL=https://reselliq.up.railway.app

# Leave unset for local dev — Vite proxy handles it via vite.config.ts

# Demo / preview mode — frontend uses mocked API responses, no backend needed.
# Set this on Vercel when you want to share a preview before Railway is deployed.
# VITE_DEMO_MODE=true
