# ResellIQ backend — environment variables. Copy to .env for local dev.

# Environment: "development" (default) or "production"
ENVIRONMENT=development

# Database — SQLite for dev. Production uses Postgres (Supabase / Railway / Neon).
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# JWT secret — MUST be a random long string in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# SECRET_KEY=

# CORS origins (comma-separated, exact match).
CORS_ORIGINS_RAW=http://localhost:5173,http://127.0.0.1:5173
# Production example:
# CORS_ORIGINS_RAW=https://reselliq.vercel.app,https://reselliq.example.com
#
# Optional regex covering preview deploys + custom domains in one pattern.
# Set this to avoid manually maintaining the list every time Vercel makes
# a new URL. Recommended for production.
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app
#
# Even broader (matches your production + all previews + custom subdomains):
# CORS_ORIGIN_REGEX=https://(reselliq\.com|.*\.vercel\.app|.*\.reselliq\.com)

# Seed credentials for the initial owner + investor accounts. Production MUST
# override OWNER_PASSWORD (server will refuse to boot if it's still "password").
OWNER_EMAIL=owner@reselliq.local
OWNER_PASSWORD=password
OWNER_NAME=Owner
INVESTOR_EMAIL=investor@reselliq.local
INVESTOR_PASSWORD=password
INVESTOR_NAME=Investor

# Supabase Storage for photo uploads (optional in dev — falls back to local disk).
# In production, both must be set.
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_KEY=eyJhbGciOi...
# SUPABASE_BUCKET=uploads

# Hybrid agent — which retailers run on the cloud (others handled by local agent).
# Default: only Best Buy runs cloud-side (uses official API, no IP issues).
CLOUD_RETAILERS_RAW=bestbuy

# Agent bearer token. Generate a random string and use the SAME value in the
# agent's .env. Required for /api/agent/* endpoints.
# AGENT_TOKEN=

# Skip the login screen entirely. Frontend auto-signs in as the owner.
# Only use if you trust everyone who has the URL.
# DISABLE_AUTH=true
