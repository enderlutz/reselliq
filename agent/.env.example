# ResellIQ local agent — environment variables

# Required: cloud API
RESELLIQ_API_URL=https://your-app.up.railway.app
AGENT_TOKEN=paste-the-same-AGENT_TOKEN-you-set-on-the-cloud

# How often the agent polls (minutes). Minimum reasonable: 10.
AGENT_INTERVAL_MIN=15

# Stores per watch — how many nearby stores to resolve and check per SKU.
# Default 10. Bump to 15 if you want broader coverage (~50% more requests).
# Each retailer's max-radius cap still applies; this just decides how many
# of those stores get polled.
AGENT_STORES_PER_WATCH=10

# Required ONLY if you have Sam's Club watches.
# Paste the full Cookie: header value from a logged-in samsclub.com session.
# Open DevTools → Network → click any XHR request → Request Headers → copy "cookie".
SAMSCLUB_COOKIE=

# Local SQLite for the agent's state cache (Target redsky API key, etc.).
# Default works fine; only override if you want a different path.
# DATABASE_URL=sqlite:///./agent_state.db
